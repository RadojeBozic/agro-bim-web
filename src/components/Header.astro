---
const nav = [["Početna", "#pocetna"], ["Usluge", "#usluge"], ["Digital", "#digital"], ["Media", "#media"], ["Shop", "#shop"], ["O nama", "#o-nama"], ["Kontakt", "#kontakt"]];
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-cream/95 backdrop-blur-sm"><div class="shell flex min-h-18 items-center justify-between gap-4 py-3">
  <a href="#pocetna" class="focus-ring flex items-center gap-3 rounded-md" aria-label="Agro BiM — početna"><img src="/images/brand/agro-bim-logo.png" alt="" class="size-11 object-contain" /><span class="leading-tight"><strong class="font-display block text-lg text-olive">Agro BiM</strong><span class="block text-[.68rem] text-muted-ink">Vaš stručni konsultant</span></span></a>
  <nav aria-label="Glavna navigacija" class="hidden lg:block"><ul class="flex items-center gap-6">{nav.map(([label, href]) => <li><a href={href} class="focus-ring rounded text-sm font-medium text-ink/75 transition hover:text-olive">{label}</a></li>)}</ul></nav>
  <a href="https://agrobim.digital" class="focus-ring hidden rounded-full bg-olive px-6 py-3 text-sm font-semibold text-cream transition hover:bg-olive-dark lg:inline-flex">Agro BiM Digital</a>
  <details class="relative lg:hidden"><summary class="focus-ring grid size-10 cursor-pointer list-none place-items-center rounded-full border border-line bg-white" aria-label="Glavni meni"><svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary><nav aria-label="Mobilna navigacija" class="absolute right-0 top-13 w-64 rounded-2xl border border-line bg-cream p-3 shadow-xl"><ul>{nav.map(([label, href]) => <li><a href={href} class="focus-ring block rounded-lg border-b border-line/60 px-3 py-3 font-medium last:border-0">{label}</a></li>)}</ul><a href="https://agrobim.digital" class="focus-ring mt-3 flex justify-center rounded-full bg-olive px-5 py-3 text-sm font-semibold text-cream">Agro BiM Digital</a></nav></details>
</div></header>
