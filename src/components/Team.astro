---
const team = [
  { name:"Miroslav Božić", role:"Dipl. inž. poljoprivrede · suosnivač, stručna podrška", image:"/images/team/miroslav-bozic.jpg", quote:"Naš zadatak nije samo da pomognemo ljudima da popune formular — već da im otvorimo vrata ka razvoju i osnažimo ih da razmišljaju kao lideri svojih gazdinstava.", phone:"+381 64 075 0381", href:"tel:+381640750381" },
  { name:"Bojana Popić", role:"Dipl. inž. poljoprivrede (voćarstvo i vinogradarstvo) · suosnivačica, stručna podrška", image:"/images/team/bojana-popic.jpg", quote:"Poljoprivreda nije samo posao, već način života. Voćari, vinogradari, stočari i povrtari imaju svoju viziju — mi smo ruka podrške kada dođe vreme za konkurse i administraciju.", phone:"+381 64 954 5572", href:"tel:+381649545572" },
];
---
<section class="section-pad bg-sand" aria-labelledby="team-title"><div class="shell"><div class="max-w-2xl"><p class="eyebrow">Ljudi iza Agro BiM-a</p><h2 id="team-title" class="mt-3 text-4xl md:text-5xl">Stručnjaci sa terena</h2></div><div class="mt-12 grid gap-8 md:grid-cols-2">{team.map(person => <article class="flex flex-col gap-6 rounded-2xl bg-white p-6 sm:flex-row sm:p-8"><img src={person.image} alt={person.name} loading="lazy" class="size-32 shrink-0 rounded-2xl object-cover object-top sm:size-40" /><div><h3 class="text-2xl">{person.name}</h3><p class="mt-1 text-sm leading-6 text-muted-ink">{person.role}</p><blockquote class="mt-4 border-l-2 border-gold pl-4 italic leading-7 text-ink/85">„{person.quote}”</blockquote><a href={person.href} class="focus-ring mt-5 inline-flex rounded font-semibold text-olive hover:underline">{person.phone}</a></div></article>)}</div></div></section>
