---
const testimonials = [
  ["Mislim da nam je ovako nešto više nego potrebno. Često i ne znamo šta je to što možemo koristiti od sredstava za podsticaj.","Nemanja M.","Drenovac"],
  ["Naročito su mi interesantni ovi projekti koje sufinansira EU. Tu je dobrodošla pomoć i podrška ove agencije.","Marko K.","Ševarice"],
  ["Nadam se da će ova inicijativa zaživeti. Nama poljoprivrednicima baš treba ovakva podrška.","Nikola J.","Sovljak"],
];
---
<section class="section-pad" aria-labelledby="testimonials-title"><div class="shell"><div class="max-w-2xl"><p class="eyebrow">Iskustva klijenata</p><h2 id="testimonials-title" class="mt-3 text-4xl md:text-5xl">Šta kažu naši klijenti</h2></div><div class="mt-12 grid gap-6 md:grid-cols-3">{testimonials.map(([quote,name,place]) => <figure class="flex flex-col rounded-2xl border border-line bg-white p-7"><span aria-hidden="true" class="font-display text-5xl leading-none text-gold">„</span><blockquote class="mt-1 flex-1 leading-7 text-ink/90">{quote}</blockquote><figcaption class="mt-6 border-t border-line pt-4 text-sm"><strong>{name}</strong><span class="text-muted-ink"> · {place}</span></figcaption></figure>)}</div></div></section>
