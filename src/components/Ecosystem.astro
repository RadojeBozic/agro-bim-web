---
const items = [
  { id:"digital", name:"Agro BiM Digital", text:"Podsticaji, javni pozivi, informacije o finansiranju i digitalni alati na jednom mestu.", img:"/images/agriculture/setva.webp", href:"https://agrobim.digital" },
  { id:"media", name:"Agro BiM Media", text:"Vesti iz poljoprivrede, vodiči, analize i stručni sadržaj.", img:"/images/agriculture/berba.webp", status:"U pripremi" },
  { id:"shop", name:"Agro BiM Shop", text:"Poljoprivredni proizvodi, oprema i ponude za gazdinstva.", img:"/images/agriculture/zima.webp", status:"U pripremi" },
];
---
<section class="section-pad bg-[#f3eee1]" aria-labelledby="ecosystem-title"><div class="shell"><div class="max-w-2xl"><p class="eyebrow">Ekosistem</p><h2 id="ecosystem-title" class="mt-3 text-4xl md:text-5xl">Jedan brend, više puteva podrške</h2><p class="mt-4 text-lg leading-8 text-muted-ink">Agro BiM se razvija povezujući znanje sa terena, korisne informacije i savremene digitalne mogućnosti.</p></div><div class="mt-12 grid gap-6 md:grid-cols-3">{items.map(item => <article id={item.id} class="flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border border-line bg-white"><img src={item.img} alt="" loading="lazy" class="h-40 w-full object-cover" /><div class="flex flex-1 flex-col p-7"><div class="flex flex-wrap items-center gap-3"><h3 class="text-xl">{item.name}</h3>{item.status && <span class="rounded-full bg-gold/25 px-3 py-1 text-xs font-semibold text-[#735515]">{item.status}</span>}</div><p class="mt-3 flex-1 leading-7 text-muted-ink">{item.text}</p>{item.href ? <a href={item.href} class="focus-ring mt-5 self-start rounded font-semibold text-olive hover:underline">Posetite platformu <span aria-hidden="true">↗</span></a> : <span class="mt-5 text-sm text-muted-ink">Uskoro dostupno</span>}</div></article>)}</div></div></section>
